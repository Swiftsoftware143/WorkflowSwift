{
  "manifest_version": 3,
  "name": "Swift Market Intel",
  "version": "1.1.0",
  "description": "Browser bridge for WorkflowSwift. Collect market intelligence from 12+ platforms including Etsy, Amazon, Facebook Marketplace, Shopify, and more.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://*.etsy.com/*",
    "https://*.pinterest.com/*",
    "https://*.tiktok.com/*",
    "https://*.yelp.com/*",
    "https://*.google.com/maps/*",
    "https://*.instagram.com/*",
    "https://*.amazon.com/*",
    "https://*.ebay.com/*",
    "https://workflowswift.com/*",
    "<all_urls>",
    "https://*.facebook.com/*",
    "https://*.craigslist.org/*",
    "https://*.shopify.com/*",
    "https://*.myshopify.com/*",
    "https://*.alibaba.com/*",
    "https://*.aliexpress.com/*",
    "https://www.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Swift Market Intel"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://*.etsy.com/*",
        "https://*.pinterest.com/*",
        "https://*.tiktok.com/*",
        "https://*.yelp.com/*",
        "https://*.google.com/maps/*",
        "https://*.instagram.com/*",
        "https://*.amazon.com/*",
        "https://*.ebay.com/*",
        "https://*.facebook.com/*",
        "https://*.craigslist.org/*",
        "https://*.shopify.com/*",
        "https://*.myshopify.com/*",
        "https://*.alibaba.com/*",
        "https://*.aliexpress.com/*",
        "https://www.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}