# workflowswift — environment TEMPLATE (placeholders only, safe to publish)
#
# Real values are NEVER committed. The deployment source of truth on this host is
#   /etc/swift/env/workflowswift.env      (mode 600, injected into the container at start)
# Copy this file to .env only for a local run and fill in real values; .env is gitignored.
#
# Kanban t_5ed88f7b: a .env carrying real-looking values used to be TRACKED here and
# PUBLISHED on origin/main (key names: DATABASE_URL, REDIS_URL, HOST, PORT, RUST_LOG,
# JWT_SECRET, SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD). Every credential in it
# was measured DEAD before removal — no rotation, no history rewrite:
#   * the tracked DB password is REJECTED by the live Postgres (FATAL: password
#     authentication failed for user "swift"), and differs from the live container's
#     (tracked vs live hint sha256[:8] = 0a9581c0 vs a6690fa9);
#   * the tracked JWT_SECRET (d88baac7 len=27) is not this app's signing key (live
#     deploy env and container both 68f6d12a len=64);
#   * the tracked REDIS_URL carried NO password while the live Redis requires one.
#   * nothing in this repo even loads a .env: there is no dotenv/dotenvy dependency, so the
#     file was inert — untracking it changes no runtime behaviour.
# Evidence (key names + hints only, never a value):
#   /opt/swift/audits/cs8164-scanners-t_b9b18e04/REPORT.md  (sibling repo, same class)
#   /opt/swift/audits/cs8164-scanners-t_8164f023/REPORT.md  (the snapshot that surfaced this file)

# --- read by src/config.rs -------------------------------------------------
DATABASE_URL=postgres://swift:CHANGE_ME@localhost:5432/workflowswift
JWT_SECRET=CHANGE_ME_strong_random_32_bytes_min
INTERNAL_SYNC_KEY=CHANGE_ME
CORESWIFT_URL=http://localhost:8084
FUNNELSWIFT_URL=http://localhost:8080
CALLBACK_BASE_URL=http://workflowswift:8085
N8N_URL=http://localhost:5678
N8N_API_KEY=CHANGE_ME
N8N_WEBHOOK_URL=CHANGE_ME
# The bind address is APP_HOST / APP_PORT (src/config.rs).
# The tracked file's HOST / PORT are NOT read by any code path — do not resurrect them.
APP_HOST=127.0.0.1
APP_PORT=8085

# --- read by the rest of src/ ----------------------------------------------
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379
PROVIDER_KEY_ENC_SECRET=CHANGE_ME_64_hex
EMAIL_API_URL=CHANGE_ME
EMAIL_API_KEY=CHANGE_ME
EMAIL_FROM=CHANGE_ME

# --- optional knobs (code has a default; deploy env leaves them unset) -----
AUTH_IN_FLIGHT_CAP=64
EXEC_WORKER_DISABLED=false
EXEC_WORKER_INTERVAL_SECS=60
MIGRATIONS_FATAL=true

# --- deploy-time knobs (see /etc/swift/env/workflowswift.env) --------------
RUST_LOG=info
DB_MIN_CONNECTIONS=2
DB_MAX_CONNECTIONS=10
JWT_ACCESS_TOKEN_EXPIRY=86400
JWT_REFRESH_TOKEN_EXPIRY=2592000

# NOTE: SMTP_HOST / SMTP_PORT / SMTP_USERNAME / SMTP_PASSWORD used to sit in the tracked
# file. No code reads them any more (mail goes out through the EMAIL_API_* keys above and
# src/email.rs), so they are deliberately absent.
