<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WorkflowSwift Admin</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--bg:#0f1117;--surface:#1a1d27;--surface2:#232736;--border:#2d3248;--text:#e1e4ed;--text2:#8b8fa3;--accent:#4f86f7;--accent2:#6ca0f9;--green:#34d399;--red:#ef4444;--yellow:#fbbf24;--orange:#fb923c;--radius:8px}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--text);min-height:100vh}
a{color:var(--accent);text-decoration:none}
input,select,textarea{background:var(--surface2);border:1px solid var(--border);color:var(--text);padding:10px 14px;border-radius:var(--radius);font-size:14px;width:100%}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--accent)}
button{cursor:pointer;font-size:14px;border:none;border-radius:var(--radius);padding:10px 20px;transition:all .2s}
.btn-primary{background:var(--accent);color:#fff}.btn-primary:hover{background:var(--accent2)}
.btn-secondary{background:var(--surface2);color:var(--text);border:1px solid var(--border)}.btn-secondary:hover{background:var(--border)}
.btn-danger{background:var(--red);color:#fff}.btn-danger:hover{opacity:.85}
.btn-sm{padding:6px 12px;font-size:12px}
table{width:100%;border-collapse:collapse}
th,td{padding:10px 12px;text-align:left;border-bottom:1px solid var(--border);font-size:13px}
th{color:var(--text2);font-weight:600;text-transform:uppercase;font-size:11px;letter-spacing:.5px}
tr:hover{background:rgba(79,134,247,.04)}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:20px;margin-bottom:16px}
.stat-card{padding:20px;text-align:center}.stat-card .num{font-size:28px;font-weight:700;color:var(--accent)}.stat-card .label{color:var(--text2);font-size:12px;text-transform:uppercase;margin-top:4px}
.grid-4{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px}
.modal-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.6);z-index:100;display:flex;align-items:center;justify-content:center}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:24px;width:90%;max-width:500px;max-height:80vh;overflow-y:auto}
.modal h2{margin-bottom:16px}.modal label{display:block;margin-bottom:4px;color:var(--text2);font-size:12px;margin-top:10px}.modal .actions{display:flex;gap:8px;justify-content:flex-end;margin-top:20px}
#app{display:flex;min-height:100vh}
.sidebar{width:240px;background:var(--surface);border-right:1px solid var(--border);padding:20px 0;flex-shrink:0}
.sidebar .logo{padding:0 20px 20px;font-size:18px;font-weight:700;color:var(--accent);border-bottom:1px solid var(--border);margin-bottom:12px}
.sidebar .user-info{padding:0 20px 16px;font-size:12px;color:var(--text2);border-bottom:1px solid var(--border);margin-bottom:12px}
.sidebar nav a{display:flex;align-items:center;gap:10px;padding:10px 20px;color:var(--text2);font-size:13px;transition:all .2s;border-left:3px solid transparent}
.sidebar nav a:hover,.sidebar nav a.active{color:var(--text);background:rgba(79,134,247,.08);border-left-color:var(--accent)}
.main{flex:1;padding:24px;overflow-x:auto}
.main h1{font-size:22px;margin-bottom:20px}
.main .top-bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
.tabs{display:flex;gap:4px;margin-bottom:20px;border-bottom:1px solid var(--border);padding-bottom:0}
.tabs button{background:none;color:var(--text2);padding:8px 16px;font-size:13px;border-bottom:2px solid transparent;border-radius:0}
.tabs button.active{color:var(--accent);border-bottom-color:var(--accent)}
.loading{text-align:center;padding:40px;color:var(--text2)}.error{color:var(--red);padding:12px;background:rgba(239,68,68,.1);border-radius:var(--radius);margin-bottom:12px;font-size:13px}
.success{color:var(--green);padding:12px;background:rgba(52,211,153,.1);border-radius:var(--radius);margin-bottom:12px;font-size:13px}
.empty{text-align:center;padding:40px;color:var(--text2);font-size:14px}
#login-page{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:20px}
.login-box{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:40px;width:100%;max-width:400px}
.login-box h1{text-align:center;margin-bottom:8px;color:var(--accent);font-size:24px}
.login-box p{text-align:center;color:var(--text2);margin-bottom:24px;font-size:13px}
.login-box label{display:block;font-size:12px;color:var(--text2);margin-bottom:4px;margin-top:14px}
.login-box button{width:100%;margin-top:20px}
.badge{display:inline-block;padding:2px 8px;border-radius:12px;font-size:11px;font-weight:600}
.badge-active{background:rgba(52,211,153,.15);color:var(--green)}
.badge-inactive{background:rgba(239,68,68,.15);color:var(--red)}
.badge-pending{background:rgba(251,191,36,.15);color:var(--yellow)}
.pagination{display:flex;gap:8px;justify-content:center;align-items:center;padding:16px 0;font-size:13px}
.pagination button{background:var(--surface2);color:var(--text);padding:6px 12px;border:1px solid var(--border)}
.pagination button:disabled{opacity:.4;cursor:default}
@media(max-width:768px){.sidebar{width:60px;overflow:hidden}.sidebar .logo{font-size:14px;padding:12px 16px}.sidebar nav a{padding:10px 16px;justify-content:center}.sidebar nav a span{display:none}.sidebar .user-info{display:none}.main{padding:16px}}
</style>
</head>
<body>
<div id="login-page" style="display:none">
<div class="login-box">
<h1>⚡ WorkflowSwift</h1>
<p>Admin Dashboard</p>
<div id="login-error" class="error" style="display:none"></div>
<label>Email</label>
<input type="email" id="login-email" value="swiftsoftware143@yahoo.com" placeholder="swiftsoftware143@yahoo.com">
<label>Password</label>
<input type="password" id="login-password" value="SwiftAdmin2026!" placeholder="••••••••">
<button class="btn-primary" onclick="login()">Sign In</button>
</div>
</div>
<div id="app" style="display:none">
<div class="sidebar">
<div class="logo">⚡ WFSwift</div>
<div class="user-info" id="user-info">swiftsoftware143@yahoo.com<br>Admin</div>
<nav>
<a href="#" onclick="showPage('dashboard')" data-page="dashboard" class="active"><span>📊</span><span>Dashboard</span></a>
<a href="#" onclick="showPage('workflows')" data-page="workflows"><span>🔄</span><span>Workflows</span></a>
<a href="#" onclick="showPage('templates')" data-page="templates"><span>📋</span><span>Templates</span></a>
<a href="#" onclick="showPage('prospecting')" data-page="prospecting"><span>🔍</span><span>Prospecting</span></a>
<a href="#" onclick="showPage('brand-monitor')" data-page="brand-monitor"><span>📡</span><span>Brand Monitor</span></a>
<a href="#" onclick="showPage('competitor-watch')" data-page="competitor-watch"><span>🏆</span><span>Competitor Watch</span></a>
<a href="#" onclick="showPage('clients')" data-page="clients"><span>👥</span><span>Clients</span></a>
<a href="#" onclick="showPage('invoices')" data-page="invoices"><span>💰</span><span>Invoices</span></a>
<a href="#" onclick="showPage('credits')" data-page="credits"><span>⭐</span><span>Credits</span></a>
<a href="#" onclick="showPage('instances')" data-page="instances"><span>📦</span><span>Instances</span></a>
<a href="#" onclick="showPage('extension')" data-page="extension" style="margin-top:12px;border-top:1px solid var(--border);padding-top:12px"><span>🧩</span><span>Extension</span></a>
<a href="#" onclick="logout()"><span>🚪</span><span>Logout</span></a>
</nav>
</div>
<div class="main" id="main-content"></div>
</div>
<script>
const API = window.location.origin + '/api/v1';
let token = localStorage.getItem('wfs_token');
let currentUser = null;

function $(id){return document.getElementById(id)}
function show(el){el.style.display=''}
function hide(el){el.style.display='none'}

async function api(path, opts={}){
  const headers={'Content-Type':'application/json'};
  if(token) headers['Authorization']='Bearer '+token;
  const res=await fetch(API+path,{...opts,headers});
  if(res.status===401 && token){token=null;localStorage.removeItem('wfs_token');render()}
  const data=await res.json();
  if(!res.ok) throw new Error(data.message||data.error||'Request failed');
  return data;
}

async function login(){
  const email=$('login-email').value;
  const password=$('login-password').value;
  hide($('login-error'));
  try{
    const res=await api('/auth/login',{method:'POST',body:JSON.stringify({email,password})});
    token=res.access_token||res.token;
    currentUser=res.user;
    localStorage.setItem('wfs_token',token);
    render();
  }catch(e){
    $('login-error').textContent=e.message;
    show($('login-error'));
  }
}

function logout(){
  token=null;currentUser=null;
  localStorage.removeItem('wfs_token');
  render();
}

async function loadUser(){
  try{
    const res=await api('/auth/me');
    currentUser=res;
    $('user-info').innerHTML=currentUser.email+'<br>'+(currentUser.role||'User');
  }catch(e){/*ignore*/}
}

function render(){
  if(token){
    hide($('login-page'));
    show($('app'));
    loadUser();
    showPage('dashboard');
  }else{
    show($('login-page'));
    hide($('app'));
  }
}

let currentPage='';

async function showPage(page){
  currentPage=page;
  document.querySelectorAll('.sidebar nav a').forEach(a=>a.classList.toggle('active',a.dataset.page===page));
  const mc=$('main-content');
  mc.innerHTML='<div class="loading">Loading...</div>';
  const renderers={
    dashboard:renderDashboard,
    workflows:renderWorkflows,
    templates:renderTemplates,
    prospecting:renderProspecting,
    'brand-monitor':renderBrandMonitor,
    'competitor-watch':renderCompetitorWatch,
    clients:renderClients,
    invoices:renderInvoices,
    credits:renderCredits,
    instances:renderInstances,
    extension:renderExtension,
  };
  try{
    await renderers[page]();
  }catch(e){
    mc.innerHTML='<div class="error">Failed to load: '+e.message+'</div>';
  }
}

/* ===== DASHBOARD ===== */
async function renderDashboard(){
  let stats,widgets;
  try{stats=await api('/dashboard/stats')}catch(e){stats=null}
  try{widgets=await api('/dashboard/widgets')}catch(e){widgets=null}
  const mc=$('main-content');
  let html='<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px"><h1 style="margin:0">📊 Market Intel Dashboard</h1><button class="btn-secondary btn-sm" onclick="showDataEntryForm()">+ Add Data</button></div>';
  if(widgets?.widgets?.length){
    html+='<div style="margin-bottom:12px;"><span class="badge badge-active">'+esc(widgets.industry_name||'')+'</span> <span style="color:var(--text2);font-size:12px">'+widgets.widgets.length+' widgets</span></div>';
    html+='<div class="widget-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px">';
    widgets.widgets.forEach(w=>{
      const val=w.data?.value||w.data?.count||w.data?.items||w.data?.amount||null;
      const suffix=w.config?.suffix||'';
      const curr=w.config?.currency?'$':'';
      html+='<div class="card" style="padding:16px;position:relative">';
      html+='<div style="font-size:11px;color:var(--text2);text-transform:uppercase;letter-spacing:.5px">'+esc(w.title)+'</div>';
      if(w.widget_type==='stat-counter'||w.widget_type==='revenue-card'){
        html+='<div style="font-size:28px;font-weight:700;color:var(--accent);margin:6px 0 2px">'+(val!==null?curr+esc(String(val))+suffix:'—')+'</div>';
      }else if(w.widget_type==='list'){
        const items=w.data?.items||w.data||[];
        html+='<div style="margin:6px 0;font-size:12px">';
        if(items.length){items.slice(0,5).forEach(i=>{html+='<div style="padding:4px 0;border-bottom:1px solid var(--border)">• '+esc(i.name||i.title||i)+'</div>';});}
        else{html+='<div class="empty" style="padding:12px">No data yet</div>';}
        html+='</div>';
      }else if(w.widget_type==='connection-status'){
        const ok=w.data?.connected||w.data?.status==='ok';
        html+='<div style="margin:10px 0;font-size:13px"><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:'+(ok?'var(--green)':'var(--red)')+';margin-right:8px"></span>'+(ok?'All Connected':'Needs Setup')+'</div>';
      }else if(w.widget_type==='chart-trend'){
        html+='<div style="margin:10px 0;height:60px;background:var(--surface2);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--text2)">📈 Trend chart</div>';
      }else if(w.widget_type==='activity-feed'){
        const acts=w.data?.activities||w.data?.items||[];
        html+='<div style="margin:6px 0;font-size:12px;max-height:120px;overflow-y:auto">';
        if(acts.length){acts.slice(0,5).forEach(a=>{html+='<div style="padding:4px 0;border-bottom:1px solid var(--border);font-size:11px">'+esc(a.action||a.title||a)+'</div>';});}
        else{html+='<div class="empty" style="padding:8px">No activity</div>';}
        html+='</div>';
      }else{
        html+='<div style="font-size:24px;font-weight:700;color:var(--accent);margin:6px 0 2px">'+(val!==null?esc(String(val)):'—')+'</div>';
      }
      html+='<div style="font-size:10px;color:var(--text2);margin-top:4px">'+esc(w.config?.subtitle||'')+'</div>';
      html+='</div>';
    });
    html+='</div>';
  }else{
    const s=stats?.stats||{};
    html+='<div class="grid-4">';
    html+='<div class="card stat-card"><div class="num">'+(s.total_workflows||0)+'</div><div class="label">Workflows</div></div>';
    html+='<div class="card stat-card"><div class="num">'+(s.active_instances||0)+'</div><div class="label">Active Instances</div></div>';
    html+='<div class="card stat-card"><div class="num">'+(s.total_clients||0)+'</div><div class="label">Clients</div></div>';
    html+='<div class="card stat-card"><div class="num">'+(s.total_templates||0)+'</div><div class="label">Templates</div></div>';
    html+='</div>';
  }
  html+='<div class="card"><h3 style="margin-bottom:12px">Recent Activity</h3>';
  try{const act=await api('/dashboard/activity');if(act?.activities?.length){html+='<div style="font-size:13px">'+act.activities.slice(0,10).map(a=>'<div style="padding:6px 0;border-bottom:1px solid var(--border)">'+esc(a.action)+' — '+esc(a.entity_type)+' <span style="color:var(--text2);font-size:11px">'+esc(a.created_at?.slice(0,10)||'')+'</span></div>').join('')+'</div>';}else{html+='<div class="empty">No recent activity</div>';}}catch(e){html+='<div class="empty">Activity feed</div>';}
  html+='</div>';
  mc.innerHTML=html;
}

/* ===== DATA ENTRY FORM FOR MANUAL DATA PUSH ===== */
function showDataEntryForm(){
  const overlay=document.createElement('div');
  overlay.className='modal-overlay';
  overlay.onclick=e=>{if(e.target===overlay)overlay.remove()};
  overlay.innerHTML='<div class="modal" style="max-width:600px"><h2>📝 Add Dashboard Data</h2>'
    +'<p style="font-size:12px;color:var(--text2);margin-bottom:12px">Enter market data to populate your dashboard widgets. This gets pushed to the widget by metric_key.</p>'
    +'<label>Metric Key</label>'
    +'<select id="data-metric-key" style="margin-bottom:8px">'
    +'<option value="marketplace_listings">Active Listings Across Markets</option>'
    +'<option value="avg_selling_price">Avg Selling Price (30d)</option>'
    +'<option value="trending_categories">Trending Categories</option>'
    +'<option value="portfolio_value">Your Portfolio Value</option>'
    +'<option value="competitor_activity">Competitor Activity</option>'
    +'<option value="market_split">SaaS vs Content vs Ecom</option>'
    +'<option value="recent_sales">Recent Market Activity</option>'
    +'<option value="multiples_by_category">Multiples by Category</option>'
    +'</select>'
    +'<label>Value (number or JSON)</label>'
    +'<input id="data-value" placeholder="e.g. 42 or {"items":[{"name":"SaaS site for $50k"}]}" style="margin-bottom:8px">'
    +'<div class="actions"><button class="btn-secondary" onclick="this.closest(\'\'.modal-overlay\'\').remove()">Cancel</button>'
    +'<button class="btn-primary" onclick="submitDashboardData(this)">Push to Dashboard</button></div></div>';
  document.body.appendChild(overlay);
}

async function submitDashboardData(btn){
  const key=document.getElementById('data-metric-key').value;
  const raw=document.getElementById('data-value').value;
  if(!raw){showToast('Enter a value','error');return;}
  btn.textContent='Pushing...';btn.disabled=true;
  try{
    let value=raw;
    if(raw.startsWith('{')||raw.startsWith('[')){value=JSON.parse(raw);}
    else if(!isNaN(Number(raw))){value=Number(raw);}
    await api('/dashboard/push-widget-data',{method:'POST',body:JSON.stringify({metric_key:key,value:value})});
    btn.closest('.modal-overlay').remove();
    showToast('Data pushed to dashboard!');
    renderDashboard();
  }catch(e){showToast(e.message,'error');btn.textContent='Push to Dashboard';btn.disabled=false;}
}

/* ===== WORKFLOWS ===== */
let workflows=[],wfPage=1,wfPerPage=20,wfSearch='';
async function renderWorkflows(){
  try{workflows=await api('/workflows')}catch(e){workflows=[]}
  if(!Array.isArray(workflows))workflows=workflows?.data||workflows?.workflows||[];
  renderWorkflowsTable();
}
function renderWorkflowsTable(){
  const start=(wfPage-1)*wfPerPage;
  const filtered=workflows.filter(w=>!wfSearch||(w.name||'').toLowerCase().includes(wfSearch.toLowerCase()));
  const page=filtered.slice(start,start+wfPerPage);
  const totalPages=Math.ceil(filtered.length/wfPerPage)||1;
  const mc=$('main-content');
  mc.innerHTML='<div class="top-bar"><h1>🔄 Workflows</h1><button class="btn-primary" onclick="showWorkflowForm()">+ New Workflow</button></div>'
    +'<div style="margin-bottom:12px"><input placeholder="Search workflows..." oninput="wfSearch=this.value;wfPage=1;renderWorkflowsTable()" style="max-width:300px"></div>'
    +'<div class="card" style="padding:0;overflow-x:auto"><table>'
    +'<tr><th>Name</th><th>Status</th><th>Template</th><th>Steps</th><th>Created</th><th>Actions</th></tr>'
    +page.map(w=>'<tr><td>'+esc(w.name||w.title||'—')+'</td><td><span class="badge badge-'+((w.status==='active'||w.status==='published')?'active':'inactive')+'">'+esc(w.status||'draft')+'</span></td><td>'+esc(w.template_name||'—')+'</td><td>'+(w.step_count||0)+'</td><td>'+(w.created_at?new Date(w.created_at).toLocaleDateString():'—')+'</td><td><button class="btn-secondary btn-sm" onclick="editWorkflow(\''+(w.id||'')+'\')">Edit</button> <button class="btn-danger btn-sm" onclick="deleteWorkflow(\''+(w.id||'')+'\')">Del</button></td></tr>').join('')
    +'</table></div>'
    +'<div class="pagination"><button onclick="wfPage=Math.max(1,wfPage-1);renderWorkflowsTable()" '+(wfPage<=1?'disabled':'')+'>← Prev</button><span>Page '+wfPage+' of '+totalPages+'</span><button onclick="wfPage=Math.min(totalPages,wfPage+1);renderWorkflowsTable()" '+(wfPage>=totalPages?'disabled':'')+'>Next →</button></div>';
}

function showWorkflowForm(w){showModal('Workflow',w||{});}
function editWorkflow(id){
  const w=workflows.find(x=>x.id===id);
  if(w)showWorkflowForm(w);else showToast('Workflow not found','error');
}
async function deleteWorkflow(id){
  if(!confirm('Delete this workflow?'))return;
  try{await api('/workflows/'+id,{method:'DELETE'});workflows=workflows.filter(w=>w.id!==id);renderWorkflowsTable();showToast('Deleted');}
  catch(e){showToast(e.message,'error')}
}

/* ===== TEMPLATES ===== */
let templates=[],tplPage=1,tplSearch='',tplIndustry='all',industries=[];
async function renderTemplates(){
  try{industries=await api('/industries')}catch(e){industries=[]}
  if(!Array.isArray(industries))industries=industries?.industries||[];
  const query=tplIndustry==='all'?'':'?industry='+tplIndustry;
  try{templates=await api('/templates'+query)}catch(e){templates=[]}
  if(!Array.isArray(templates))templates=templates?.data||templates?.templates||[];
  renderTemplatesGallery();
}
function renderTemplatesGallery(){
  const start=(tplPage-1)*20;
  const filtered=templates.filter(t=>!tplSearch||(t.name||'').toLowerCase().includes(tplSearch.toLowerCase()));
  const page=filtered.slice(start,start+20);
  const tp=Math.ceil(filtered.length/20)||1;
  const mc=$('main-content');
  let html='<div class="top-bar"><h1>📋 Template Gallery</h1></div>';
  html+='<div style="margin-bottom:12px"><input placeholder="Search templates..." oninput="tplSearch=this.value;tplPage=1;renderTemplatesGallery()" style="max-width:300px;display:inline-block;margin-right:8px">';
  html+='<select onchange="tplIndustry=this.value;tplPage=1;renderTemplates()" style="max-width:250px;display:inline-block"><option value="all">All Industries</option>';
  (industries.industries||industries).forEach(c=>{html+='<option value="'+esc(c.slug)+'"'+(tplIndustry===c.slug?' selected':'')+'>'+esc(c.name||c.slug)+' ('+(c.template_count||0)+')</option>';});
  html+='</select></div>';
  if(page.length===0){html+='<div class="card"><div class="empty">No templates found for this industry</div></div>';}
  else{html+='<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px">';
  page.forEach(t=>{
    const cat=t.category||'general';
    const icons={'sales-lead-gen':'💼','service-businesses':'🔧','recruitment-staffing':'👥','marketing-agencies':'📣','marketing':'📣','professional-services':'⚖️','ecommerce-retail':'🛒','healthcare-wellness':'🏥','construction-development':'🏗️','grant-funding':'💰','government-contracting':'🏛️','education-training':'📚','publishing-media':'📰','site-flipping':'🔄','onboarding':'📁','operations':'⚙️'};
    const icon=icons[cat]||'📋';
    html+='<div class="card" style="padding:16px;display:flex;flex-direction:column;gap:8px">';
    html+='<div style="font-size:28px">'+icon+'</div>';
    html+='<div style="font-weight:600;font-size:14px">'+esc(t.name||'Untitled')+'</div>';
    html+='<div style="font-size:12px;color:var(--text2);flex:1">'+(t.description?esc(t.description).slice(0,100):'No description')+'</div>';
    html+='<div style="display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--text2)"><span>'+(t.step_count||t.steps?.length||0)+' steps</span><span class="badge badge-active">'+esc(cat)+'</span></div>';
    html+='<button class="btn-primary btn-sm" onclick="cloneTemplate(\''+esc(t.id)+'\',\''+esc(t.name)+'\')">+ Clone to Workflow</button>';
    html+='</div>';
  });
  html+='</div>';}
  html+='<div class="pagination"><button onclick="tplPage=Math.max(1,tplPage-1);renderTemplatesGallery()" '+(tplPage<=1?'disabled':'')+'>← Prev</button><span>Page '+tplPage+' of '+tp+'</span><button onclick="tplPage=Math.min(tp,tplPage+1);renderTemplatesGallery()" '+(tplPage>=tp?'disabled':'')+'>Next →</button></div>';
  mc.innerHTML=html;
}
async function cloneTemplate(id,name){
  try{
    const res=await api('/workflows',{method:'POST',body:JSON.stringify({name:name+' (cloned)',template_id:id,description:'Cloned from template'})});
    showToast('Cloned! View in Workflows');
    if(res.id){workflows.push(res);}
  }catch(e){showToast(e.message,'error');}
}

/* ===== DATA ENTRY FORM (reused by prospecting/brand/competitor) ===== */
function dashboardTabBar(tabs, activeTab, onSwitch){
  let html='<div class="tabs">';
  tabs.forEach(t=>{html+='<button class="'+(t.id===activeTab?'active':'')+'" onclick="'+onSwitch.name+'(\''+t.id+'\')">'+esc(t.label||t.name||t.id)+'</button>';});
  html+='</div>';
  return html;
}

async function showConnectWorkflowModal(sourceType, sourceId){
  let workflows;
  try{workflows=await api('/workflows')}catch(e){workflows=[]}
  if(!Array.isArray(workflows))workflows=workflows?.data||workflows?.workflows||[];
  const overlay=document.createElement('div');
  overlay.className='modal-overlay';
  overlay.onclick=e=>{if(e.target===overlay)overlay.remove()};
  overlay.innerHTML='<div class="modal"><h2>🔗 Connect to Workflow</h2>'
    +'<p style="font-size:12px;color:var(--text2);margin-bottom:12px">Link this data source to a workflow step.</p>'
    +'<label>Source Type</label><input value="'+esc(sourceType)+'" readonly style="opacity:.6">'
    +'<label>Source ID</label><input value="'+esc(sourceId)+'" readonly style="opacity:.6">'
    +'<label>Workflow</label><select id="connect-workflow-select">'
    +(workflows.length?workflows.map(w=>'<option value="'+esc(w.id)+'">'+esc(w.name||w.title||w.id.slice(0,8))+'</option>').join(''):'<option value="">No workflows found</option>')
    +'</select>'
    +'<label>Step (optional)</label><input id="connect-step" placeholder="e.g. analyze_data">'
    +'<div class="actions"><button class="btn-secondary" onclick="this.closest(\'.modal-overlay\').remove()">Cancel</button>'
    +'<button class="btn-primary" onclick="submitConnectWorkflow(this,\'"+sourceType+"\',\'"+sourceId+"')">Connect</button></div></div>';
  document.body.appendChild(overlay);
}

async function submitConnectWorkflow(btn, sourceType, sourceId){
  const workflowId=document.getElementById('connect-workflow-select').value;
  const step=document.getElementById('connect-step').value||'';
  if(!workflowId){showToast('Select a workflow','error');return;}
  btn.textContent='Connecting...';btn.disabled=true;
  try{
    await api('/dashboard/connect-workflow',{method:'POST',body:JSON.stringify({source_type:sourceType,source_id:sourceId,workflow_id:workflowId,step:step})});
    btn.closest('.modal-overlay').remove();
    showToast('Connected to workflow!');
  }catch(e){showToast(e.message,'error');btn.textContent='Connect';btn.disabled=false;}
}

/* ===== BRAND MONITOR ===== */
let brandMonitors=[], brandResults={};
async function renderBrandMonitor(){
  try{brandMonitors=await api('/dashboard/brand-monitor')}catch(e){brandMonitors=[]}
  if(!Array.isArray(brandMonitors))brandMonitors=brandMonitors?.data||brandMonitors?.items||[];
  renderBrandMonitorList();
}
function renderBrandMonitorList(){
  const mc=$('main-content');
  let html='<div class="top-bar"><h1>📡 Brand Monitor</h1><button class="btn-primary" onclick="showBrandMonitorForm()">+ Track Brand</button></div>';
  html+='<p style="font-size:12px;color:var(--text2);margin-bottom:12px">Monitor brand mentions, sentiment, and social presence across the web.</p>';
  if(brandMonitors.length===0){html+='<div class="card"><div class="empty">No brands being monitored. Click "+ Track Brand" to start.</div></div>';}
  else{html+='<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px">';
  brandMonitors.forEach(b=>{
    const results=brandResults[b.id]||[];
    const latest=results[0];
    html+='<div class="card" style="padding:16px">';
    html+='<div style="display:flex;justify-content:space-between;align-items:start">';
    html+='<div><div style="font-weight:600;font-size:14px">'+esc(b.name||b.brand||'Unnamed')+'</div>';
    html+='<div style="font-size:11px;color:var(--text2);margin-top:2px">'+(b.keywords||b.name||'')+'</div></div>';
    html+='<button class="btn-danger btn-sm" onclick="deleteBrandMonitor(\''+esc(b.id)+'\')">✕</button>';
    html+='</div>';
    if(latest){html+='<div style="margin:8px 0;font-size:12px;color:var(--text2)">Latest: '+esc((latest.title||latest.content||'').slice(0,80))+'</div>';}
    html+='<div style="display:flex;gap:8px;margin-top:8px">';
    html+='<button class="btn-secondary btn-sm" onclick="loadBrandResults(\''+esc(b.id)+'\')">📊 View Mentions ('+(results.length||0)+')</button>';
    html+='<button class="btn-secondary btn-sm" onclick="showConnectWorkflowModal(\'brand-monitor\',\''+esc(b.id)+'\')">🔗</button>';
    html+='</div></div>';
  });
  html+='</div>';}
  mc.innerHTML=html;
}
function showBrandMonitorForm(){
  const overlay=document.createElement('div');
  overlay.className='modal-overlay';
  overlay.onclick=e=>{if(e.target===overlay)overlay.remove()};
  overlay.innerHTML='<div class="modal"><h2>📡 Track New Brand</h2>'
    +'<label>Brand Name</label><input id="bm-name" placeholder="e.g. Nike">'
    +'<label>Keywords (comma separated)</label><input id="bm-keywords" placeholder="e.g. Nike, Just Do It, swoosh">'
    +'<label>Platforms to monitor</label><select id="bm-platforms" multiple style="height:80px"><option value="etsy" selected>Etsy</option><option value="pinterest" selected>Pinterest</option><option value="tiktok">TikTok</option><option value="yelp">Yelp</option><option value="google_maps">Google Maps</option><option value="instagram">Instagram</option></select>'
    +'<p style="font-size:11px;color:var(--text2);margin-top:4px">Hold Ctrl/Cmd to select multiple</p>'
    +'<div class="actions"><button class="btn-secondary" onclick="this.closest(\'.modal-overlay\').remove()">Cancel</button>'
    +'<button class="btn-primary" onclick="createBrandMonitor(this)">Start Monitoring</button></div></div>';
  document.body.appendChild(overlay);
}
async function createBrandMonitor(btn){
  const name=document.getElementById('bm-name').value;
  const keywords=document.getElementById('bm-keywords').value;
  const sel=document.getElementById('bm-platforms');
  const platforms=Array.from(sel.selectedOptions).map(o=>o.value);
  if(!name){showToast('Enter a brand name','error');return;}
  btn.textContent='Creating...';btn.disabled=true;
  try{
    const res=await api('/dashboard/brand-monitor',{method:'POST',body:JSON.stringify({name:name,keywords:keywords||name,platforms:platforms})});
    btn.closest('.modal-overlay').remove();
    showToast('Brand monitor created!');
    brandMonitors.push(res.data||res.item||res);
    renderBrandMonitorList();
  }catch(e){showToast(e.message,'error');btn.textContent='Start Monitoring';btn.disabled=false;}
}
async function loadBrandResults(id){
  try{
    brandResults[id]=await api('/dashboard/brand-monitor/'+id+'/results');
    if(!Array.isArray(brandResults[id]))brandResults[id]=brandResults[id]?.data||brandResults[id]?.items||[];
  }catch(e){brandResults[id]=[];}
  renderBrandResultsModal(id);
}
function renderBrandResultsModal(id){
  const results=brandResults[id]||[];
  const b=brandMonitors.find(x=>x.id===id);
  const overlay=document.createElement('div');
  overlay.className='modal-overlay';
  overlay.onclick=e=>{if(e.target===overlay)overlay.remove()};
  let html='<div class="modal" style="max-width:700px"><h2>📊 '+esc(b?.name||'Brand')+' Mentions</h2>';
  if(results.length===0){html+='<div class="empty">No mentions found yet. Run a search to find mentions.</div>';}
  else{results.slice(0,20).forEach(r=>{
    const sentiment=r.sentiment||'neutral';
    const icons={positive:'🟢',negative:'🔴',neutral:'🟡'};
    html+='<div style="padding:10px 0;border-bottom:1px solid var(--border);font-size:13px">';
    html+='<div style="display:flex;justify-content:space-between"><span>'+icons[sentiment]+' '+esc((r.title||r.content||'').slice(0,100))+'</span><span style="font-size:11px;color:var(--text2)">'+(r.platform||'')+'</span></div>';
    if(r.url)html+='<div style="font-size:11px;color:var(--accent);margin-top:2px"><a href="'+esc(r.url)+'" target="_blank">'+esc(r.url.slice(0,60))+'</a></div>';
    html+='</div>';
  });}
  html+='<div class="actions"><button class="btn-secondary" onclick="this.closest(\'.modal-overlay\').remove()">Close</button></div></div>';
  overlay.innerHTML=html;
  document.body.appendChild(overlay);
}
async function deleteBrandMonitor(id){
  if(!confirm('Remove this brand monitor?'))return;
  try{await api('/dashboard/brand-monitor/'+id,{method:'DELETE'});brandMonitors=brandMonitors.filter(b=>b.id!==id);renderBrandMonitorList();showToast('Removed');}
  catch(e){showToast(e.message,'error')}
}

/* ===== COMPETITOR WATCH ===== */
let competitors=[], competitorChanges={};
async function renderCompetitorWatch(){
  try{competitors=await api('/dashboard/competitor-watch')}catch(e){competitors=[]}
  if(!Array.isArray(competitors))competitors=competitors?.data||competitors?.items||[];
  renderCompetitorList();
}
function renderCompetitorList(){
  const mc=$('main-content');
  let html='<div class="top-bar"><h1>🏆 Competitor Watch</h1><button class="btn-primary" onclick="showCompetitorForm()">+ Track Competitor</button></div>';
  html+='<p style="font-size:12px;color:var(--text2);margin-bottom:12px">Monitor competitor websites, pricing changes, and new activity.</p>';
  if(competitors.length===0){html+='<div class="card"><div class="empty">No competitors tracked. Click "+ Track Competitor" to start.</div></div>';}
  else{html+='<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px">';
  competitors.forEach(c=>{
    const changes=competitorChanges[c.id]||[];
    const latest=changes[0];
    html+='<div class="card" style="padding:16px">';
    html+='<div style="display:flex;justify-content:space-between;align-items:start">';
    html+='<div><div style="font-weight:600;font-size:14px">'+esc(c.name||'Unnamed')+'</div>';
    html+='<div style="font-size:11px;color:var(--text2);margin-top:2px">'+(c.url||c.website||'')+'</div></div>';
    html+='<button class="btn-danger btn-sm" onclick="deleteCompetitor(\''+esc(c.id)+'\')">✕</button>';
    html+='</div>';
    if(latest){html+='<div style="margin:8px 0;font-size:12px"><span style="color:var(--yellow)">⚠️</span> '+esc((latest.change||latest.title||'').slice(0,80))+'</div>';}
    html+='<div style="display:flex;gap:8px;margin-top:8px">';
    html+='<button class="btn-secondary btn-sm" onclick="loadCompetitorChanges(\''+esc(c.id)+'\')">📊 Changes ('+(changes.length||0)+')</button>';
    html+='<button class="btn-secondary btn-sm" onclick="showConnectWorkflowModal(\'competitor\',\''+esc(c.id)+'\')">🔗</button>';
    html+='</div></div>';
  });
  html+='</div>';}
  mc.innerHTML=html;
}
function showCompetitorForm(){
  const overlay=document.createElement('div');
  overlay.className='modal-overlay';
  overlay.onclick=e=>{if(e.target===overlay)overlay.remove()};
  overlay.innerHTML='<div class="modal"><h2>🏆 Track New Competitor</h2>'
    +'<label>Competitor Name</label><input id="comp-name" placeholder="e.g. Acme Corp">'
    +'<label>Website URL</label><input id="comp-url" placeholder="e.g. https://acme.com">'
    +'<label>Notes</label><textarea id="comp-notes" rows="2" placeholder="What to watch for..."></textarea>'
    +'<div class="actions"><button class="btn-secondary" onclick="this.closest(\'.modal-overlay\').remove()">Cancel</button>'
    +'<button class="btn-primary" onclick="createCompetitor(this)">Start Watching</button></div></div>';
  document.body.appendChild(overlay);
}
async function createCompetitor(btn){
  const name=document.getElementById('comp-name').value;
  const url=document.getElementById('comp-url').value;
  const notes=document.getElementById('comp-notes').value;
  if(!name){showToast('Enter a competitor name','error');return;}
  btn.textContent='Creating...';btn.disabled=true;
  try{
    const res=await api('/dashboard/competitor-watch',{method:'POST',body:JSON.stringify({name:name,url:url,notes:notes})});
    btn.closest('.modal-overlay').remove();
    showToast('Competitor tracked!');
    competitors.push(res.data||res.item||res);
    renderCompetitorList();
  }catch(e){showToast(e.message,'error');btn.textContent='Start Watching';btn.disabled=false;}
}
async function loadCompetitorChanges(id){
  try{
    competitorChanges[id]=await api('/dashboard/competitor-watch/'+id+'/changes');
    if(!Array.isArray(competitorChanges[id]))competitorChanges[id]=competitorChanges[id]?.data||competitorChanges[id]?.items||[];
  }catch(e){competitorChanges[id]=[];}
  renderChangesModal(id);
}
function renderChangesModal(id){
  const changes=competitorChanges[id]||[];
  const c=competitors.find(x=>x.id===id);
  const overlay=document.createElement('div');
  overlay.className='modal-overlay';
  overlay.onclick=e=>{if(e.target===overlay)overlay.remove()};
  let html='<div class="modal" style="max-width:700px"><h2>📊 '+esc(c?.name||'Competitor')+' Changes</h2>';
  if(changes.length===0){html+='<div class="empty">No changes detected yet.</div>';}
  else{changes.slice(0,20).forEach(ch=>{
    html+='<div style="padding:10px 0;border-bottom:1px solid var(--border);font-size:13px">';
    html+='<div>⚠️ '+esc((ch.change||ch.title||ch.description||'').slice(0,150))+'</div>';
    html+='<div style="font-size:11px;color:var(--text2);margin-top:2px">'+(ch.detected_at?new Date(ch.detected_at).toLocaleString():'')+'</div>';
    html+='</div>';
  });}
  html+='<div class="actions"><button class="btn-secondary" onclick="this.closest(\'.modal-overlay\').remove()">Close</button></div></div>';
  overlay.innerHTML=html;
  document.body.appendChild(overlay);
}
async function deleteCompetitor(id){
  if(!confirm('Remove this competitor?'))return;
  try{await api('/dashboard/competitor-watch/'+id,{method:'DELETE'});competitors=competitors.filter(c=>c.id!==id);renderCompetitorList();showToast('Removed');}
  catch(e){showToast(e.message,'error')}
}

/* ===== PROSPECTING ===== */
let prospectingSearches=[], prospectingResults={};
async function renderProspecting(){
  try{prospectingSearches=await api('/dashboard/prospecting')}catch(e){prospectingSearches=[]}
  if(!Array.isArray(prospectingSearches))prospectingSearches=prospectingSearches?.data||prospectingSearches?.items||[];
  renderProspectingList();
}
function renderProspectingList(){
  const mc=$('main-content');
  let html='<div class="top-bar"><h1>🔍 Business Prospecting</h1><button class="btn-primary" onclick="showProspectingForm()">+ New Search</button></div>';
  html+='<p style="font-size:12px;color:var(--text2);margin-bottom:12px">Search for businesses, leads, and prospects using AI-powered discovery.</p>';
  if(prospectingSearches.length===0){html+='<div class="card"><div class="empty">No searches yet. Click "+ New Search" to find prospects.</div></div>';}
  else{html+='<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:12px">';
  prospectingSearches.forEach(s=>{
    const results=prospectingResults[s.id]||[];
    html+='<div class="card" style="padding:16px">';
    html+='<div style="display:flex;justify-content:space-between;align-items:start">';
    html+='<div><div style="font-weight:600;font-size:14px">🔍 '+esc(s.query||s.name||'Search')+'</div>';
    html+='<div style="font-size:11px;color:var(--text2);margin-top:2px">'+(s.location||'')+'</div></div>';
    html+='<button class="btn-danger btn-sm" onclick="deleteProspectingSearch(\''+esc(s.id)+'\')">✕</button>';
    html+='</div>';
    html+='<div style="font-size:12px;color:var(--text2);margin:8px 0">'+(results.length||0)+' leads found</div>';
    html+='<div style="display:flex;gap:8px;margin-top:8px">';
    html+='<button class="btn-secondary btn-sm" onclick="loadProspectingResults(\''+esc(s.id)+'\')">🎯 View Leads ('+(results.length||0)+')</button>';
    html+='<button class="btn-secondary btn-sm" onclick="exportProspectingCSV(\''+esc(s.id)+'\')">📥 CSV</button>';
    html+='<button class="btn-secondary btn-sm" onclick="showConnectWorkflowModal(\'prospecting\',\''+esc(s.id)+'\')">🔗</button>';
    html+='</div></div>';
  });
  html+='</div>';}
  mc.innerHTML=html;
}
function showProspectingForm(){
  const overlay=document.createElement('div');
  overlay.className='modal-overlay';
  overlay.onclick=e=>{if(e.target===overlay)overlay.remove()};
  overlay.innerHTML='<div class="modal"><h2>🔍 New Prospect Search</h2>'
    +'<label>Search Query</label><input id="prosp-query" placeholder="e.g. plumbers in Seattle">'
    +'<label>Location</label><input id="prosp-location" placeholder="Seattle, WA">'
    +'<label>Industry</label><input id="prosp-industry" placeholder="e.g. Plumbing">'
    +'<div class="actions"><button class="btn-secondary" onclick="this.closest(\'.modal-overlay\').remove()">Cancel</button>'
    +'<button class="btn-primary" onclick="createProspectingSearch(this)">Search</button></div></div>';
  document.body.appendChild(overlay);
}
async function createProspectingSearch(btn){
  const query=document.getElementById('prosp-query').value;
  const location=document.getElementById('prosp-location').value;
  const industry=document.getElementById('prosp-industry').value;
  if(!query){showToast('Enter a search query','error');return;}
  btn.textContent='Searching...';btn.disabled=true;
  try{
    const res=await api('/dashboard/prospecting',{method:'POST',body:JSON.stringify({query:query,location:location,industry:industry})});
    btn.closest('.modal-overlay').remove();
    showToast('Search created!');
    prospectingSearches.push(res.data||res.item||res);
    renderProspectingList();
  }catch(e){showToast(e.message,'error');btn.textContent='Search';btn.disabled=false;}
}
async function loadProspectingResults(id){
  try{
    prospectingResults[id]=await api('/dashboard/prospecting/'+id+'/results');
    if(!Array.isArray(prospectingResults[id]))prospectingResults[id]=prospectingResults[id]?.data||prospectingResults[id]?.items||[];
  }catch(e){prospectingResults[id]=[];}
  renderProspectingResultsModal(id);
}
function renderProspectingResultsModal(id){
  const results=prospectingResults[id]||[];
  const s=prospectingSearches.find(x=>x.id===id);
  const overlay=document.createElement('div');
  overlay.className='modal-overlay';
  overlay.onclick=e=>{if(e.target===overlay)overlay.remove()};
  let html='<div class="modal" style="max-width:800px;max-height:90vh"><h2>🎯 '+esc(s?.query||'Results')+'</h2>';
  if(results.length===0){html+='<div class="empty">No results yet. Results will appear once the search completes.</div>';}
  else{html+='<div style="overflow-y:auto;max-height:60vh">';
  results.forEach(r=>{
    html+='<div class="card" style="padding:12px;margin-bottom:8px">';
    html+='<div style="font-weight:600;font-size:13px">'+esc(r.name||r.business_name||'Unknown')+'</div>';
    if(r.phone)html+='<div style="font-size:12px;color:var(--text2)">📞 '+esc(r.phone)+'</div>';
    if(r.email)html+='<div style="font-size:12px;color:var(--text2)">📧 '+esc(r.email)+'</div>';
    if(r.website)html+='<div style="font-size:12px;color:var(--accent)">🔗 <a href="'+esc(r.website)+'" target="_blank">'+esc(r.website.slice(0,50))+'</a></div>';
    if(r.address)html+='<div style="font-size:12px;color:var(--text2)">📍 '+esc(r.address)+'</div>';
    if(r.rating)html+='<div style="font-size:12px">'+'⭐'.repeat(Math.round(r.rating))+' '+esc(String(r.rating))+'</div>';
    html+='</div>';
  });
  html+='</div>';}
  html+='<div class="actions"><button class="btn-secondary" onclick="exportProspectingCSV(\''+esc(id)+'\')">📥 Export CSV</button><button class="btn-secondary" onclick="this.closest(\'.modal-overlay\').remove()">Close</button></div></div>';
  overlay.innerHTML=html;
  document.body.appendChild(overlay);
}
function exportProspectingCSV(id){
  const results=prospectingResults[id]||[];
  if(!results.length){showToast('No results to export','error');return;}
  const headers=['Name','Phone','Email','Website','Address','Rating'];
  const rows=results.map(r=>[r.name||r.business_name||'',r.phone||'',r.email||'',r.website||'',r.address||'',r.rating||'']);
  const csv=[headers.join(','),...rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(','))].join('\n');
  const blob=new Blob([csv],{type:'text/csv'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='prospects-'+id.slice(0,8)+'.csv';a.click();
  URL.revokeObjectURL(a.href);
  showToast('CSV exported!');
}
async function deleteProspectingSearch(id){
  if(!confirm('Delete this search?'))return;
  try{await api('/dashboard/prospecting/'+id,{method:'DELETE'});prospectingSearches=prospectingSearches.filter(s=>s.id!==id);renderProspectingList();showToast('Deleted');}
  catch(e){showToast(e.message,'error')}
}

/* ===== CLIENTS ===== */
let clients=[],clPage=1,clSearch='';
async function renderClients(){
  try{clients=await api('/clients')}catch(e){clients=[]}
  if(!Array.isArray(clients))clients=clients?.data||clients?.clients||[];
  renderClientsTable();
}
function renderClientsTable(){
  const start=(clPage-1)*20;
  const filtered=clients.filter(c=>!clSearch||(c.name||c.email||'').toLowerCase().includes(clSearch.toLowerCase()));
  const page=filtered.slice(start,start+20);
  const tp=Math.ceil(filtered.length/20)||1;
  const mc=$('main-content');
  mc.innerHTML='<div class="top-bar"><h1>👥 Clients</h1></div>'
    +'<div style="margin-bottom:12px"><input placeholder="Search clients..." oninput="clSearch=this.value;clPage=1;renderClientsTable()" style="max-width:300px"></div>'
    +'<div class="card" style="padding:0;overflow-x:auto"><table>'
    +'<tr><th>Name</th><th>Email</th><th>Company</th><th>Status</th><th>Created</th></tr>'
    +page.map(c=>'<tr><td>'+esc(c.name||'—')+'</td><td>'+esc(c.email||'—')+'</td><td>'+esc(c.company||c.company_name||'—')+'</td><td><span class="badge badge-'+(c.status==='active'?'active':'inactive')+'">'+esc(c.status||'active')+'</span></td><td>'+(c.created_at?new Date(c.created_at).toLocaleDateString():'—')+'</td></tr>').join('')
    +'</table></div>'
    +'<div class="pagination"><button onclick="clPage=Math.max(1,clPage-1);renderClientsTable()" '+(clPage<=1?'disabled':'')+'>← Prev</button><span>Page '+clPage+' of '+tp+'</span><button onclick="clPage=Math.min(tp,clPage+1);renderClientsTable()" '+(clPage>=tp?'disabled':'')+'>Next →</button></div>';
}

/* ===== INVOICES ===== */
let invoices=[],invPage=1;
async function renderInvoices(){
  try{invoices=await api('/invoices')}catch(e){invoices=[]}
  if(!Array.isArray(invoices))invoices=invoices?.data||invoices?.invoices||[];
  renderInvoicesTable();
}
function renderInvoicesTable(){
  const start=(invPage-1)*20;
  const page=invoices.slice(start,start+20);
  const tp=Math.ceil(invoices.length/20)||1;
  const mc=$('main-content');
  mc.innerHTML='<div class="top-bar"><h1>💰 Invoices</h1></div>'
    +'<div class="card" style="padding:0;overflow-x:auto"><table>'
    +'<tr><th>#</th><th>Client</th><th>Amount</th><th>Status</th><th>Due Date</th></tr>'
    +page.map(i=>'<tr><td>'+esc(i.invoice_number||i.id?.slice(0,8)||'—')+'</td><td>'+esc(i.client_name||i.client?.name||'—')+'</td><td>'+(i.amount? '$'+Number(i.amount).toFixed(2):'—')+'</td><td><span class="badge badge-'+(i.status==='paid'?'active':i.status==='overdue'?'inactive':'pending')+'">'+esc(i.status||'pending')+'</span></td><td>'+(i.due_date?new Date(i.due_date).toLocaleDateString():'—')+'</td></tr>').join('')
    +'</table></div>'
    +'<div class="pagination"><button onclick="invPage=Math.max(1,invPage-1);renderInvoicesTable()" '+(invPage<=1?'disabled':'')+'>← Prev</button><span>Page '+invPage+' of '+tp+'</span><button onclick="invPage=Math.min(tp,invPage+1);renderInvoicesTable()" '+(invPage>=tp?'disabled':'')+'>Next →</button></div>';
}

/* ===== CREDITS ===== */
async function renderCredits(){
  let creditData;
  try{creditData=await api('/credits/balance')}catch(e){creditData=null}
  const mc=$('main-content');
  mc.innerHTML='<h1>⭐ Credit Management</h1>'
    +'<div class="grid-4">'
    +  '<div class="card stat-card"><div class="num">'+(creditData?.balance||0)+'</div><div class="label">Total Credits</div></div>'
    +  '<div class="card stat-card"><div class="num">'+(creditData?.used||0)+'</div><div class="label">Used</div></div>'
    +  '<div class="card stat-card"><div class="num">'+(creditData?.available||creditData?.balance||0)+'</div><div class="label">Available</div></div>'
    +'</div>'
    +'<div class="card"><p class="empty">Credit transactions and management coming soon</p></div>';
}

/* ===== INSTANCES ===== */
let instances=[],instPage=1;
async function renderInstances(){
  try{instances=await api('/instances')}catch(e){instances=[]}
  if(!Array.isArray(instances))instances=instances?.data||instances?.instances||[];
  renderInstancesTable();
}
function renderInstancesTable(){
  const start=(instPage-1)*20;
  const page=instances.slice(start,start+20);
  const tp=Math.ceil(instances.length/20)||1;
  const mc=$('main-content');
  mc.innerHTML='<div class="top-bar"><h1>📦 Workflow Instances</h1></div>'
    +'<div class="card" style="padding:0;overflow-x:auto"><table>'
    +'<tr><th>ID</th><th>Workflow</th><th>Status</th><th>Step</th><th>Started</th></tr>'
    +page.map(i=>'<tr><td>'+esc(i.id?.slice(0,8)||'—')+'</td><td>'+esc(i.workflow_name||i.workflow?.name||'—')+'</td><td><span class="badge badge-'+(i.status==='completed'?'active':i.status==='failed'?'inactive':'pending')+'">'+esc(i.status||'running')+'</span></td><td>'+(i.current_step||i.step||0)+'</td><td>'+(i.created_at?new Date(i.created_at).toLocaleDateString():'—')+'</td></tr>').join('')
    +'</table></div>'
    +'<div class="pagination"><button onclick="instPage=Math.max(1,instPage-1);renderInstancesTable()" '+(instPage<=1?'disabled':'')+'>← Prev</button><span>Page '+instPage+' of '+tp+'</span><button onclick="instPage=Math.min(tp,instPage+1);renderInstancesTable()" '+(instPage>=tp?'disabled':'')+'>Next →</button></div>';
}

/* ===== EXTENSION ===== */
function renderExtension(){
  const mc=$('main-content');
  mc.innerHTML='<h1>?? Swift Market Intel Extension</h1>'
    +'<p style="font-size:13px;color:var(--text2);margin-bottom:20px">Install the browser extension to collect market intelligence from Etsy, Pinterest, TikTok, Yelp, Google Maps, Instagram, Amazon, and eBay. Data is automatically sent to your dashboard.</p>'
    +'<div class="grid-4">'
    +  '<div class="card" style="text-align:center">'
    +    '<div style="font-size:40px;margin-bottom:8px">??</div>'
    +    '<div style="font-weight:600;font-size:14px">Download Extension</div>'
    +    '<p style="font-size:12px;color:var(--text2);margin:8px 0">ZIP file for manual install</p>'
    +    '<a href="/swift-market-intel-extension.zip" download class="btn-primary" style="display:inline-block;padding:10px 24px;margin-top:8px">Download .zip</a>'
    +  '</div>'
    +  '<div class="card" style="text-align:center">'
    +    '<div style="font-size:40px;margin-bottom:8px">??</div>'
    +    '<div style="font-weight:600;font-size:14px">How to Install</div>'
    +    '<p style="font-size:12px;color:var(--text2);margin:8px 0;text-align:left;line-height:1.6">'
    +    '1. Download the .zip above<br>'
    +    '2. Unzip to a folder on your computer<br>'
    +    '3. Open Chrome → go to <code style="background:var(--surface2);padding:2px 6px;border-radius:4px;font-size:11px">chrome://extensions</code><br>'
    +    '4. Enable "Developer mode" (toggle top-right)<br>'
    +    '5. Click "Load unpacked"<br>'
    +    '6. Point to the unzipped folder<br>'
    +    '7. Done! Extension icon appears in toolbar'
    +    '</p>'
    +  '</div>'
    +  '<div class="card" style="text-align:center">'
    +    '<div style="font-size:40px;margin-bottom:8px">??</div>'
    +    '<div style="font-weight:600;font-size:14px">Supported Sites</div>'
    +    '<div style="font-size:12px;color:var(--text2);margin-top:8px;text-align:left;line-height:2">'
    +    '<div>?? <strong>Etsy</strong> — Product research</div>'
    +    '<div>?? <strong>Pinterest</strong> — Trend analysis</div>'
    +    '<div>?? <strong>TikTok</strong> — Viral content</div>'
    +    '<div>?? <strong>Yelp</strong> — Reviews & ratings</div>'
    +    '<div>?? <strong>Google Maps</strong> — Local business data</div>'
    +    '<div>?? <strong>Instagram</strong> — Social presence</div>'
    +    '<div>?? <strong>Amazon</strong> — Product listings</div>'
    +    '<div>?? <strong>eBay</strong> — Marketplace data</div>'
    +    '</div>'
    +  '</div>'
    +  '<div class="card" style="text-align:center">'
    +    '<div style="font-size:40px;margin-bottom:8px">??</div>'
    +    '<div style="font-weight:600;font-size:14px">Auth Setup</div>'
    +    '<p style="font-size:12px;color:var(--text2);margin:8px 0;text-align:left;line-height:1.6">'
    +    'After installing, open the extension popup and enter your API token.<br><br>'
    +    '<strong>Get your token:</strong> Go to <strong>Settings</strong> > API Keys to generate one.<br><br>'
    +    'The extension will automatically send scraped data to your WorkflowSwift dashboard.'
    +    '</p>'
    +  '</div>'
    +'</div>'
    +'<div class="card" style="margin-top:8px">'
    +  '<h3 style="margin-bottom:8px">?? API Keys</h3>'
    +  '<div id="extension-api-keys-section"></div>'
    +'</div>';
  loadExtensionApiKeys();
}

async function loadExtensionApiKeys(){
  try{
    const keys=await api('/api-keys');
    const arr=Array.isArray(keys)?keys:keys?.data||keys?.keys||[];
    const section=document.getElementById('extension-api-keys-section');
    if(!section)return;
    if(arr.length===0){
      section.innerHTML='<div class="empty">No API keys yet. <button class="btn-primary btn-sm" onclick="generateApiKey()">Generate Key</button></div>';
    }else{
      let html='<table><tr><th>Name</th><th>Key</th><th>Status</th><th></th></tr>';
      arr.forEach(k=>{
        html+='<tr><td>'+esc(k.name||'Key')+'</td><td><code style="font-size:11px;background:var(--surface2);padding:2px 6px;border-radius:4px">'+esc(k.key||k.api_key||'')+'</code></td><td><span class="badge badge-active">Active</span></td><td><button class="btn-danger btn-sm" onclick="deleteApiKey(\''+esc(k.id)+'\')">Delete</button></td></tr>';
      });
      html+='</table><button class="btn-primary btn-sm" style="margin-top:8px" onclick="generateApiKey()">+ Generate New Key</button>';
      section.innerHTML=html;
    }
  }catch(e){/*ignore*/}
}

async function generateApiKey(){
  const name=prompt('Name this API key:');
  if(!name)return;
  try{
    const res=await api('/api-keys',{method:'POST',body:JSON.stringify({name:name})});
    showToast('API key generated: '+(res.key||res.api_key||'saved'));
    loadExtensionApiKeys();
  }catch(e){showToast(e.message,'error');}
}

async function deleteApiKey(id){
  if(!confirm('Delete this API key?'))return;
  try{await api('/api-keys/'+id,{method:'DELETE'});loadExtensionApiKeys();showToast('Deleted');}
  catch(e){showToast(e.message,'error');}
}

/* ===== MODAL ===== */
function showModal(title,data){
  const overlay=document.createElement('div');
  overlay.className='modal-overlay';
  overlay.onclick=e=>{if(e.target===overlay)overlay.remove()};
  overlay.innerHTML='<div class="modal"><h2>'+esc(title)+'</h2><form id="modal-form">'
    +'<label>Name</label><input name="name" value="'+(data.name||data.title||'')+'">'
    +'<label>Description</label><textarea name="description" rows="3">'+(data.description||'')+'</textarea>'
    +'</form><div class="actions"><button class="btn-secondary" onclick="this.closest(\'.modal-overlay\').remove()">Cancel</button>'
    +'<button class="btn-primary" onclick="saveModal(this)">Save</button></div></div>';
  document.body.appendChild(overlay);
}
async function saveModal(btn){
  const form=btn.closest('.modal').querySelector('#modal-form');
  const data=Object.fromEntries(new FormData(form));
  btn.textContent='Saving...';btn.disabled=true;
  if(currentPage==='workflows'){
    try{
      const res=await api('/workflows',{method:'POST',body:JSON.stringify(data)});
      if(res.id||res.workflow){workflows.push(res.workflow||res);showToast('Workflow created');}
      btn.closest('.modal-overlay')?.remove();renderWorkflows();
    }catch(e){showToast(e.message,'error');btn.textContent='Save';btn.disabled=false;}
  }else{
    setTimeout(()=>{btn.closest('.modal-overlay')?.remove();showToast('Saved');},500);
  }
}

/* ===== UTILITIES ===== */
function esc(s){if(!s)return'';const d=document.createElement('div');d.textContent=s;return d.innerHTML}
function showToast(msg,type){
  const el=document.createElement('div');
  el.className=type==='error'?'error':'success';
  el.textContent=msg;
  el.style.position='fixed';el.style.top='16px';el.style.right='16px';el.style.zIndex='200';el.style.maxWidth='400px';
  document.body.appendChild(el);
  setTimeout(()=>el.remove(),3000);
}

render();
</script>
</body>
</html>
