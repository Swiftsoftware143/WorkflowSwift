use axum::{
    routing::{get, post, put, delete},
    Router,
};

use crate::AppState;
use crate::auth;
use crate::handlers::*;
use crate::handlers::api_key_handler;

pub fn create_router(state: AppState) -> Router {
    // Public auth routes (no auth needed)
    let auth_public = Router::new()
        .route("/login", post(auth::login))
        .route("/register", post(auth::register));

    // Protected auth route
    let auth_protected = Router::new()
        .route("/me", get(auth::me));

    // Resource sub-routers (following coreswift pattern of nest + {id})
    let client_routes = Router::new()
        .route("/", get(client_handler::list_clients).post(client_handler::create_client))
        .route("/{id}", get(client_handler::get_client)
            .put(client_handler::update_client)
            .delete(client_handler::delete_client));

    let template_routes = Router::new()
        .route("/", get(template_handler::list_templates).post(template_handler::create_template))
        .route("/{id}", get(template_handler::get_template)
            .put(template_handler::update_template)
            .delete(template_handler::delete_template))
        .route("/{id}/steps", get(template_handler::get_template_steps));

    let workflow_routes = Router::new()
        .route("/", get(workflow_handler::list_workflows).post(workflow_handler::create_workflow))
        .route("/{id}", get(workflow_handler::get_workflow)
            .put(workflow_handler::update_workflow)
            .delete(workflow_handler::delete_workflow))
        .route("/{id}/start", post(workflow_handler::start_workflow))
        .route("/{id}/steps", get(workflow_handler::get_workflow_steps));

    let instance_routes = Router::new()
        .route("/", get(instance_handler::list_instances))
        .route("/{id}", get(instance_handler::get_instance)
            .put(instance_handler::update_instance))
        .route("/{id}/advance", post(instance_handler::advance_instance));

    let tag_routes = Router::new()
        .route("/", get(tag_handler::list_tags).post(tag_handler::create_tag))
        .route("/assign", post(tag_handler::assign_tag))
        .route("/unassign", post(tag_handler::unassign_tag));

    let plan_routes = Router::new()
        .route("/", get(plan_handler::list_plans).post(plan_handler::create_plan));

    let credit_routes = Router::new()
        .route("/balance", get(credit_handler::credit_balance))
        .route("/package", post(credit_handler::create_credit_package));

    let automation_routes = Router::new()
        .route("/", get(automation_handler::list_automations).post(automation_handler::create_automation))
        .route("/{id}/run", post(automation_handler::run_automation));

    let tenant_routes = Router::new()
        .route("/", get(tenant_handler::get_tenant).put(tenant_handler::update_tenant));

    let user_routes = Router::new()
        .route("/", get(user_handler::list_users))
        .route("/invite", post(user_handler::invite_user));

    let dashboard_routes = Router::new()
        .route("/stats", get(dashboard_handler::dashboard_stats))
        .route("/activity", get(dashboard_handler::dashboard_activity));

    // Protected routes with auth middleware (following coreswift pattern)
    let api_key_routes = Router::new()
        .route("/", get(api_key_handler::list_api_keys).post(api_key_handler::create_api_key))
        .route("/{id}", put(api_key_handler::update_api_key).delete(api_key_handler::delete_api_key));

    let protected_routes = Router::new()
        .nest("/auth", auth_protected)
        .nest("/tenants", tenant_routes)
        .nest("/users", user_routes)
        .nest("/clients", client_routes)
        .nest("/templates", template_routes)
        .nest("/workflows", workflow_routes)
        .nest("/instances", instance_routes)
        .nest("/tags", tag_routes)
        .nest("/plans", plan_routes)
        .nest("/credits", credit_routes)
        .nest("/automations", automation_routes)
        .nest("/dashboard", dashboard_routes)
        .layer(axum::middleware::from_fn_with_state(
            state.clone(),
            crate::auth::middleware::auth_middleware,
        ));

    // Public routes (no auth)
    let public_routes = Router::new()
        .nest("/auth", auth_public);

    // Combine: public + protected merged (no path conflicts because
    // auth/login and auth/me are separate routes under /auth)
    let api_v1 = Router::new()
        .merge(public_routes)
        .nest("/api/v1", api_v1)
        .with_state(state);

    app
}

async fn health_check() -> impl axum::response::IntoResponse {
    (axum::http::StatusCode::OK, axum::Json(serde_json::json!({
        "status": "ok",
        "service": "workflowswift-api",
        "version": env!("CARGO_PKG_VERSION")
    })))
}
